# =============================================================================
# Cybotech Backend — .env.example
# Copy to backend/.env and fill in real values.
# Used when running the backend directly (outside Docker Compose).
# Never commit the real backend/.env file.
# =============================================================================

# Application
APP_ENV=development
APP_SECRET_KEY=CHANGE_ME_32_CHARS_MINIMUM
LOG_LEVEL=INFO

# PostgreSQL — when running the DB via Docker Compose locally
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cybotech
POSTGRES_USER=cybotech_user
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

# Model provider
OPENAI_API_KEY=sk-PLACEHOLDER_REPLACE_ME
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Security and policy
ALLOWED_EMAIL_DESTINATIONS=reports@internal.example,support@internal.example
APPROVAL_TTL_SECONDS=300
SSE_RETRY_MS=3000

# Red-team / evaluation
RED_TEAM_MAX_ITERATIONS=50
RED_TEAM_SEED=42
RED_TEAM_CONFIGURATIONS=baseline,memory_guard,policy_gateway,full
