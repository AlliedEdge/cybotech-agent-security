# =============================================================================
# Cybotech — Root .env.example
# Copy to .env and fill in real values. Never commit the real .env file.
# This file contains only safe placeholder values — no real secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=development           # development | staging | production
APP_SECRET_KEY=CHANGE_ME_32_CHARS_MINIMUM
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR | CRITICAL

# -----------------------------------------------------------------------------
# PostgreSQL (used by both backend and Docker Compose)
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cybotech
POSTGRES_USER=cybotech_user
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

# Full DSN assembled from components above (used by SQLAlchemy / Alembic)
# DATABASE_URL is auto-constructed in the app from the parts above.
# Override here only if you need a non-standard connection string.
# DATABASE_URL=postgresql+psycopg://cybotech_user:CHANGE_ME@localhost:5432/cybotech

# -----------------------------------------------------------------------------
# Model provider (OpenAI-compatible)
# Replace with your actual key in the real .env — never commit it.
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-PLACEHOLDER_REPLACE_ME
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1   # override for local/alternative endpoint

# -----------------------------------------------------------------------------
# Security and policy
# -----------------------------------------------------------------------------
# Comma-separated list of allowed simulated email destinations
ALLOWED_EMAIL_DESTINATIONS=reports@internal.example,support@internal.example

# Number of seconds before an approval token expires
APPROVAL_TTL_SECONDS=300

# Maximum number of SSE reconnection seconds for front-end hint
SSE_RETRY_MS=3000

# -----------------------------------------------------------------------------
# Frontend (Vite build-time variables — must be prefixed VITE_)
# See frontend/.env.example for frontend-specific variables
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
VITE_SSE_URL=http://localhost:8000/api/v1/events

# -----------------------------------------------------------------------------
# Red-team / evaluation (safe defaults, no real credentials required)
# -----------------------------------------------------------------------------
# Maximum number of attack case iterations per run (safety bound)
RED_TEAM_MAX_ITERATIONS=50
# Seed for reproducible random case ordering
RED_TEAM_SEED=42
# Which configurations to run: baseline | memory_guard | policy_gateway | full
RED_TEAM_CONFIGURATIONS=baseline,memory_guard,policy_gateway,full
