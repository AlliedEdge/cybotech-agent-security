# =============================================================================
# Cybotech Frontend — .env.example
# Copy to frontend/.env and fill in real values.
# All Vite environment variables must be prefixed with VITE_
# Never commit the real frontend/.env file.
# =============================================================================

# Backend API base URL (no trailing slash)
VITE_API_BASE_URL=http://localhost:8000

# SSE live event stream URL
VITE_SSE_URL=http://localhost:8000/api/v1/events

# Number of recent events to fetch on SSE reconnect
VITE_SSE_REPLAY_LIMIT=100
